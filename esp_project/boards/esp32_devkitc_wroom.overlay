/ {
    aliases {
        my-led0 = &led0;
        my-heater = &heat;
        btn-up = &button_up;
        btn-down = &button_dwn;
        btn-select = &button_sel;
        btn-back = &button_bck;
    };

    leds {
        compatible = "gpio-leds";
        
        led0: d23 {
            gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
        };
        heat: d2 {
            gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
        };
    };

    gpio_keys {
        compatible = "gpio-keys";
        
        button_up: button_up {
            gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Up Button";
        };
        
        button_dwn: button_dwn {
            gpios = <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Down Button";
        };
        
        button_sel: button_sel {
            gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Select Button";
        };

        button_bck: button_bck {
            gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Back Button";
        };
    };
};

&spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;

    /* SPI device child node for data transfers */
    nokia_dev: nokia@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <400000>;
    };
};

/* Remap SPI SCLK to GPIO 5 and MOSI (DIN) to GPIO 18 */
&pinctrl {
    spi2_default: spi2_default {
        group1 {
            pinmux = <SPIM2_SCLK_GPIO5>,
                     <SPIM2_MOSI_GPIO18>;
        };
    };
};

/* Enable wifi */
&wifi {
    status = "okay";
};

&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_2";          /* Sets 6 dB attenuation (~0 to 1.5V range) */
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;              /* 12-bit resolution (0–4095) */
    };
};