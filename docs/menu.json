{
  "screens": {
    "D0": {
      "name": "",
      "type": "display",
      "description": "Front Page",
      "items": [
        {
          "type": "composite_value",
          "id": "temp_reading",
          "label": "Temperature",
          "value_source": ["Temp_Detected", "Temp_Heat_Unused"]
        },
        {
          "type": "value",
          "id": "time",
          "label": "Time",
          "example": "17H35"
        },
        {
          "type": "value",
          "id": "date",
          "label": "Date",
          "example": "29/10/2026"
        },
        {
          "type": "status",
          "id": "state",
          "label": "STATE",
          "options": ["EN CHAUFFE", "REGUL."],
          "ui_properties": {
            "blinking_values": ["EN CHAUFFE"]
          }
        }
      ]
    },
    "M0": {
      "name": "MENU",
      "type": "menu",
      "description": "When one button is pressed",
      "items": [
        {
          "label": "TEMP.EAU",
          "navigation_target": "M0_0"
        },
        {
          "label": "CHAUFFER",
          "navigation_target": "M0_1"
        },
        {
          "label": "PARAMETRES",
          "navigation_target": "M0_2"
        }
      ]
    },
    "M0_0": {
      "name": "TEMP.EAU",
      "type": "info",
      "description": "Information about temperatures detected/analysed",
      "items": [
        {
          "type": "read_only_value",
          "id": "temp_max",
          "label": "MAX",
          "description": "Local Max Value detected (Pic of temperature as water flows through the hot-pipe)"
        },
        {
          "type": "read_only_value",
          "id": "temp_min",
          "label": "MIN",
          "description": "Local Min Value detected (When water is not used, the hot-pipe is cooling down)"
        },
        {
          "type": "read_only_value",
          "id": "temp_actuelle",
          "label": "ACTUELLE",
          "description": "Current value (current temperature of the hot-pipe)"
        },
        {
          "type": "read_only_value",
          "id": "temp_cible",
          "label": "T.CIBLE",
          "description": "Temperature to reach"
        }
      ]
    },
    "M0_1": {
      "name": "CHAUFFER\nMAINTENANT",
      "type": "action_menu",
      "description": "CHAUFFER",
      "items": [
        {
          "type": "editable_enum",
          "id": "duree",
          "label": "DUREE",
          "description": "Heat duration",
          "options": [
            "0H15",
            "0H30",
            "0H45",
            "1H00",
            "1H15",
            "1H30",
            "1H45",
            "2H00",
            "2H30",
            "3H00"
          ]
        }
      ]
    },
    "M0_2": {
      "name": "PARAMETRES",
      "type": "settings",
      "description": "These are the settings",
      "items": [
        {
          "type": "editable_enum",
          "id": "regul",
          "label": "REGUL",
          "options": ["ON", "F.ON", "OFF"],
          "description": "Regulation ON, F.ON heats fully defined period. OFF means no heat at all."
        },
        {
          "type": "editable_value",
          "id": "heure",
          "label": "HEURE",
          "format": "HH'H'MM",
          "example": "17H35"
        },
        {
          "type": "editable_enum",
          "id": "date_mode",
          "label": "DATE",
          "options": ["MANU", "AUTO"],
          "action": "SELECT_AND_MODIFY"
        },
       {
          "type": "navigation",
          "label": "HORAIRES CH.",
          "navigation_target": "M0_2_0"
        },
        {
          "type": "editable_value",
          "id": "t_cible",
          "label": "T.CIBLE",
          "action": "MODIFY_HERE"
        }
      ]
    },
    "M0_2_0": {
      "name": "HORAIRE CH.",
      "type": "settings",
      "description": "2 Heating periods possible",
      "items": [
        {
          "type": "editable_value",
          "id": "debut1",
          "label": "DEBUT1",
          "default": "0H00"
        },
        {
          "type": "editable_value",
          "id": "fin1",
          "label": "FIN1",
          "default": "2H00"
        },
        {
          "type": "editable_value",
          "id": "debut2",
          "label": "DEBUT2",
          "default": "17H30",
          "allow_null_symbol": "--"
        },
        {
          "type": "editable_value",
          "id": "fin2",
          "label": "FIN2",
          "default": "20H00",
          "allow_null_symbol": "--"
        }
      ]
    }
  }
}

